# Google AI Studio API key. Read server-side only — never expose to the browser.
GEMINI_API_KEY=

# Port the Hono server listens on (Vite proxies /api here).
PORT=8787

# Seniority mode (Live API, ticket 013) — optional overrides.
# The native-audio Live model. `-preview` ids churn; re-check before a release (see interviewer.ts).
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Prebuilt voice for the interviewer persona.
# GEMINI_LIVE_VOICE=Kore
